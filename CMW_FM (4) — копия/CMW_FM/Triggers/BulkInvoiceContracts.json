            "ConditionExpression": "GREATEREQ(ENDOFMONTH(from a in db->Contracts_calc where EQUALS(a, $$origin) select a->ValidUntil_calc),\n          ENDOFMONTH(ADDYEARS(from b in db->MaintenancePeriods_calc where EQUALS(b, $$dialogVariables->Period_calc) select b->WorkStartDate_calc, (from c in db->Years where EQUALS(c, $$dialogVariables->Year) select c->Year - 2024))))",
