                    },
                    "SetValueKind": "Replace",
                    "ValueExpression": "STARTOFMONTH(NOW())"
                  },
                  {
                    "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue, Comindware.Platform.Contracts",
                    "PropertyPath": {
                      "$type": "Comindware.Platform.Contracts.GlobalAlias[], Comindware.Platform.Contracts",
                      "$values": [
                        {
                          "$type": "Comindware.Platform.Contracts.GlobalAlias, Comindware.Platform.Contracts",
                          "Alias": "PaymentPeriod_calc",
                          "Owner": "InvoicesPayments_calc",
                          "Solution": "CMW_FM",
                          "Type": "Attribute"
                        }
                      ]
                    },
                    "SetValueKind": "Replace",
                    "ValueExpression": "OBJECT(\"CMW_FM\", \"MaintenancePeriods_calc\", \"SortOrder_calc\", MONTH(NOW()))"
                  },
                  {
                    "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue, Comindware.Platform.Contracts",
                    "PropertyPath": {
                      "$type": "Comindware.Platform.Contracts.GlobalAlias[], Comindware.Platform.Contracts",
                      "$values": [
                        {
                          "$type": "Comindware.Platform.Contracts.GlobalAlias, Comindware.Platform.Contracts",
                          "Alias": "DocType_calc",
                          "Owner": "InvoicesPayments_calc",
                          "Solution": "CMW_FM",
                          "Type": "Attribute"
                        }
                      ]
                    },
                    "SetValueKind": "Replace",
                    "ValueExpression": "ENUMVALUE(\"DocType_calc\", \"Issued_calc\")"
                  },
                  {
                    "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue, Comindware.Platform.Contracts",
                    "PropertyPath": {
                      "$type": "Comindware.Platform.Contracts.GlobalAlias[], Comindware.Platform.Contracts",
