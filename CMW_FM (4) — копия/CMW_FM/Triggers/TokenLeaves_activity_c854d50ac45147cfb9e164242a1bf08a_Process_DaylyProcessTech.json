                          "Solution": "CMW_FM",
                          "Type": "Attribute"
                        }
                      ]
                    },
                    "SetValueKind": "Replace",
                    "ValueExpression": "ENDOFDAY(ADDDAYS(NOW(), $ContractBasis_calc->PaymentDays_calc))"
