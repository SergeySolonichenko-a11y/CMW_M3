          "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue[], Comindware.Platform.Contracts",
          "$values": [
            {
              "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue, Comindware.Platform.Contracts",
              "PropertyPath": {
                "$type": "Comindware.Platform.Contracts.GlobalAlias[], Comindware.Platform.Contracts",
                "$values": [
                  {
                    "$type": "Comindware.Platform.Contracts.GlobalAlias, Comindware.Platform.Contracts",
                    "Alias": "DealsMakeRentInvoices_calc",
                    "Owner": "TechTemplateDeals",
                    "Solution": "CMW_FM",
                    "Type": "Attribute"
                  }
                ]
              },
              "SetValueKind": "Replace",
              "ValueExpression": "from a in db->Contracts_calc where AND(\n    a->Status->Code==\"active\",\n    a->MainDocument_calc==true,\n    EMPTY(from b in a->InvoicesPayments_calc where AND(STARTOFMONTH(b->SortOrder_calc)==STARTOFMONTH(NOW()), b->InvoiceType_calc->Code_calc==\"arenda_month\") select b->id)\n#    , EQUALS(DAY(a->Date_calc), DAY(NOW()) #Uncomment this line to issue invoices on the contract date; contracts dated December 31 and February require adjusted conditions\n    ) select a->id"
            }
          ]
        }
      },
      "TargetContainer": {
        "$type": "Comindware.Platform.Contracts.GlobalAlias, Comindware.Platform.Contracts",
        "Alias": "TechTemplateDeals",
        "Solution": "CMW_FM",
        "Type": "RecordTemplate"
      }
