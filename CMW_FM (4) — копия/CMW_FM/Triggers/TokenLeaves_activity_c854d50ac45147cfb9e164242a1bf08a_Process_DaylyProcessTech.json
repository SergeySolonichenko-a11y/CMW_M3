                          "Alias": "Year_calc",
                          "Owner": "InvoicesPayments_calc",
                          "Solution": "CMW_FM",
                          "Type": "Attribute"
                        }
                      ]
                    },
                    "SetValueKind": "Replace",
                    "ValueExpression": "from a in db->Years where a->Year==YEAR(NOW()) select a->id"
                  },
                  {
                    "$type": "Comindware.Platform.Contracts.Models.Triggers.EventTrigger.PropertySetValue, Comindware.Platform.Contracts",
                    "PropertyPath": {
                      "$type": "Comindware.Platform.Contracts.GlobalAlias[], Comindware.Platform.Contracts",
