  "QueryRule": "@prefix cmw: <http://comindware.com/logics#>.\n@prefix task: <http://comindware.com/ontology/task#>.\n@prefix taskStatus: <http://comindware.com/ontology/taskStatus#>.\n@prefix account: <http://comindware.com/ontology/account#>.\n@prefix role: <http://comindware.com/ontology/role#>.\n\n{\n    # Find tasks associated with the current record\n    cmw:securityContext cmw:currentUser ?currentUser.  \n    ?task task:objectId ?item.\n    ?task cmw:taskStatus taskStatus:inProgress.\n\n    # Filter active tasks\n    # Determine the task assignee\n    or{\n        # Return the actual assignee\n        ?task cmw:assignee ?assigneeRoles.\n        ?assigneeRoles role:roleMembers ?groupMembers.\n        ?groupMembers account:groupUsers ?currentUser.\n    }\n    or {\n\n        # Return the actual assignee\n        ?task cmw:assignee ?assigneeRoles.\n        ?assigneeRoles role:roleMembers ?currentUser.\n    }\n    or {\n        # Return the actual assignee\n        ?task cmw:assignee ?currentUser.\n    }\n    or{\n        # Return the list of possible assignees\n        ?task cmw:possibleAssignee ?assigneeRoles.\n        ?assigneeRoles role:roleMembers ?groupMembers.\n        ?groupMembers account:groupUsers ?currentUser.\n    }\n    or {\n\n        # Return the list of possible assignees\n        ?task cmw:possibleAssignee ?assigneeRoles.\n        ?assigneeRoles role:roleMembers ?currentUser.\n    }\n    or {\n        # Return the list of possible assignees\n        ?task cmw:possibleAssignee ?currentUser.\n\n    }.\n    ?task -> ?value.\n}",
